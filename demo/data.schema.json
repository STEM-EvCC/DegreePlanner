{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stem-evcc.github.io/DegreePlanner/demo/data.schema.json",
  "title": "EvCC Pathways Data",
  "description": "Demo copy of the PathwaysData schema with two more areas (science, health). Shared data for the EvCC Degree Planner and Pathways sites: courses, EvCC programs, university and BAS programs, careers and advising notes. Schema version 1. Areas: engineering, cs, it and amtec (advanced manufacturing).",
  "type": "object",
  "required": ["schema_version", "meta", "majors", "careers", "wages", "it_entry", "layout_overrides", "courses", "programs", "schools", "advisor_notes"],
  "properties": {
    "schema_version": { "const": 1 },

    "meta": {
      "type": "object",
      "required": ["catalog_year", "checked", "built", "statewide"],
      "properties": {
        "catalog_year": { "type": "string", "pattern": "^\\d{4}-\\d{4}$" },
        "checked": { "type": "string", "minLength": 1 },
        "built": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "statewide": { "type": "array", "items": { "$ref": "#/$defs/school" } }
      }
    },

    "majors": {
      "description": "Major id -> display name. Program and school entries refer to these ids.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },

    "careers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "short", "area", "blurb", "credentials", "soc", "certs"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "short": { "type": "string" },
          "area": { "$ref": "#/$defs/area" },
          "blurb": { "type": "string" },
          "credentials": { "description": "EvCC program ids", "type": "array", "items": { "type": "string" } },
          "soc": { "type": "array", "items": { "type": "string", "pattern": "^\\d{2}-\\d{4}$" } },
          "next": {
            "description": "Programs graduates can continue into, e.g. BAS options",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["school", "program"],
              "properties": {
                "school": { "type": "string" },
                "program": { "type": "string", "minLength": 1 },
                "url": { "$ref": "#/$defs/url" },
                "note": { "type": "string" }
              }
            }
          },
          "certs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "courses": { "type": "array", "items": { "$ref": "#/$defs/courseCode" } }
              }
            }
          }
        }
      }
    },

    "wages": {
      "type": "object",
      "required": ["checked", "notes", "occupations"],
      "properties": {
        "occupations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["soc", "name", "wa", "seattle_msa", "us"],
            "properties": { "soc": { "type": "string", "pattern": "^\\d{2}-\\d{4}$" }, "name": { "type": "string" } }
          }
        }
      }
    },

    "it_entry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["program", "ata", "aas_t"],
        "properties": { "program": { "type": "string" }, "ata": { "type": "string" }, "aas_t": { "type": "string" } }
      }
    },

    "layout_overrides": {
      "description": "Display hints shared by both sites, e.g. draw one course in the same spot as another.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/courseCode" },
      "additionalProperties": {
        "type": "object",
        "properties": { "same_as": { "$ref": "#/$defs/courseCode" } }
      }
    },

    "courses": {
      "description": "EvCC courses keyed by catalog code, e.g. \"MATH& 151\".",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/courseCode" },
      "additionalProperties": { "$ref": "#/$defs/course" }
    },

    "programs": { "type": "array", "items": { "$ref": "#/$defs/program" } },
    "schools": { "type": "array", "items": { "$ref": "#/$defs/school" } },

    "advisor_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "source", "date"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "date": { "type": "string" },
          "courses": { "type": "array", "items": { "$ref": "#/$defs/courseCode" } },
          "majors": { "type": "array", "items": { "type": "string" } },
          "schools": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "area": { "enum": ["engineering", "cs", "it", "amtec", "science", "health"] },
    "courseCode": { "type": "string", "pattern": "^[A-Z][A-Z& ]*\\s\\d{2,3}[A-Z]?$" },
    "url": { "type": "string", "pattern": "^https?://" },

    "prereq": {
      "description": "Prerequisite tree: {all:[...]} and {any:[...]} nodes, with {course, concurrent} leaves.",
      "type": "object",
      "properties": {
        "all": { "type": "array", "items": { "$ref": "#/$defs/prereq" } },
        "any": { "type": "array", "items": { "$ref": "#/$defs/prereq" } },
        "course": { "$ref": "#/$defs/courseCode" },
        "concurrent": { "type": "boolean" }
      },
      "anyOf": [{ "required": ["all"] }, { "required": ["any"] }, { "required": ["course"] }]
    },

    "course": {
      "type": "object",
      "required": ["title", "credits", "description", "prereq_text", "prereq", "placement", "eligibility", "min_grade", "url", "year_used"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "short": { "type": "string" },
        "credits": { "type": "string", "pattern": "^\\d+(\\.\\d+)?(-\\d+(\\.\\d+)?)?$" },
        "description": { "type": "string" },
        "prereq_text": { "type": "string" },
        "prereq": { "$ref": "#/$defs/prereq" },
        "placement": { "type": "string" },
        "eligibility": { "type": "array" },
        "min_grade": { "type": "string" },
        "url": { "$ref": "#/$defs/url" },
        "year_used": { "type": "string" },
        "offered": { "type": "array", "items": { "type": "string" } },
        "offered_src": { "type": "string" },
        "hidden": { "type": "boolean" }
      }
    },

    "groupItem": {
      "type": "object",
      "oneOf": [
        { "required": ["course"], "properties": { "course": { "$ref": "#/$defs/courseCode" } } },
        { "required": ["one_of"], "properties": { "one_of": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/courseCode" } } } },
        { "required": ["slot", "label"], "properties": { "slot": { "type": "string" }, "label": { "type": "string" } } }
      ]
    },

    "program": {
      "description": "An EvCC degree or certificate.",
      "type": "object",
      "required": ["id", "name", "credential", "code", "active", "area", "kind", "majors", "total", "url", "potential_prereqs", "spec", "groups"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "credential": { "type": "string", "minLength": 1 },
        "code": { "type": "string" },
        "active": { "type": "string" },
        "area": { "$ref": "#/$defs/area" },
        "kind": { "enum": ["transfer", "professional-technical"] },
        "majors": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "total": { "type": "number", "minimum": 0 },
        "url": { "$ref": "#/$defs/url" },
        "potential_prereqs": { "type": "array", "items": { "type": "string" } },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "credits", "items"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "credits": { "type": "number" },
              "min_grade": { "type": "string" },
              "note": { "type": "string" },
              "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/groupItem" } }
            }
          }
        }
      }
    },

    "requirement": {
      "type": "object",
      "required": ["category", "courses", "logic"],
      "properties": {
        "category": { "enum": ["admission", "pre-transfer", "degree", "recommended"] },
        "logic": { "enum": ["all", "one"] },
        "options": { "type": "array", "minItems": 2, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/courseCode" } }, "description": "A choice between course sets: met by completing every course in any one set (e.g. a C++ pair or a Java pair). Use with logic 'one'; courses lists every course in the sets." },
        "courses": { "type": "array", "items": { "$ref": "#/$defs/courseCode" } },
        "univ_equiv": { "type": "string" },
        "min_grade": { "type": "string" },
        "note": { "type": "string" }
      }
    },

    "school": {
      "description": "A university, or a college offering BAS/BS programs, and the programs EvCC students transfer into.",
      "type": "object",
      "required": ["id", "name", "campus", "short", "type", "location", "website", "general_notes", "programs", "abbr"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "campus": { "type": "string" },
        "short": { "type": "string", "minLength": 1 },
        "type": { "enum": ["public", "private"] },
        "kind": { "enum": ["bas-cc"] },
        "location": { "type": "string" },
        "website": { "$ref": "#/$defs/url" },
        "general_notes": { "type": "array", "items": { "type": "string" } },
        "abbr": { "type": "string" },
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["major", "degree", "dept_url", "admission", "requirements", "notes", "sources", "verified"],
            "properties": {
              "major": { "$ref": "#/$defs/id" },
              "degree": { "type": "string", "minLength": 1 },
              "dept_url": { "type": "string" },
              "admission": { "type": "object" },
              "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
              "choose_groups": { "type": "array" },
              "notes": { "type": "array", "items": { "type": "string" } },
              "sources": { "type": "array", "items": { "type": "string" } },
              "verified": { "enum": ["verified", "partial", "unverified"] }
            }
          }
        }
      }
    }
  }
}
